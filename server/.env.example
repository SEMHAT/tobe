PORT=8787
# E-mails de l'équipe ToBe (accès à l'espace agence), séparés par des virgules
ADMIN_EMAILS=vous@exemple.com
# En production : false (le code n'est envoyé que par e-mail)
EXPOSE_OTP=false
# Envoi des codes de connexion (https://resend.com)
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=eledji.com
# EMAIL_FROM=ToBe <connexion@eledji.com>
# true seulement quand le paiement Mobile Money est branché
PAYMENTS_ENABLED=false
# Données d'exemple : uniquement en local
SEED=false
# Origines autorisées pour l'API (application mobile, site)
CORS_ORIGINS=https://tobe.eledji.com
DATA_DIR=./data
UPLOAD_DIR=./uploads
